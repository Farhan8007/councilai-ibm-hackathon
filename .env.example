# ─── IBM watsonx Credentials ───────────────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── Agent Model Config ────────────────────────────────────
SECURITY_AGENT_MODEL=meta-llama/llama-3-3-70b-instruct
ARCHITECTURE_AGENT_MODEL=meta-llama/llama-3-3-70b-instruct
TESTING_AGENT_MODEL=meta-llama/llama-3-3-70b-instruct
PERFORMANCE_AGENT_MODEL=meta-llama/llama-3-3-70b-instruct
# ─── Backend Server ────────────────────────────────────────
PORT=8000
ENV=development

# ─── Frontend ──────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000