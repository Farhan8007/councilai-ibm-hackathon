# ===== GITHUB WEBHOOK =====
# Get this from: https://github.com/settings/tokens
# Required scopes: repo, read:repo_hook
GITHUB_TOKEN=ghp_your_personal_access_token_here
# GitHub webhook secret (set on https://github.com/yourrepo/settings/hooks)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ===== DATABASE =====
# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/councilai
DATABASE_URL=postgresql://councilai:councilai_password@localhost:5433/councilai

# ===== IBM WATSONX =====
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=your_ibm_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ===== AGENT SERVICE (Person A) =====
# Base URL where Person A's agent council endpoint is served.
# Orchestrator POSTs the structured diff here and expects 4 verdicts back.
AGENT_SERVICE_URL=http://localhost:8100
AGENT_TIMEOUT_SECONDS=30

# ===== SERVER =====
# Port to run FastAPI on
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

# ===== LOGGING =====
LOG_LEVEL=INFO
