{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CouncilAI structured diff",
  "description": "Contract Person B produces and Person A's agents consume. Committed at the Hour 1 sync.",
  "type": "object",
  "required": ["pr_id", "repo", "files", "change_type", "change_confidence"],
  "properties": {
    "pr_id": {"type": "integer"},
    "repo": {"type": "string", "description": "owner/repo"},
    "change_type": {
      "type": "string",
      "enum": ["auth_change", "schema_migration", "perf_critical", "ui_only",
               "config_change", "feature_addition", "bug_fix", "refactor", "unknown"]
    },
    "change_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "diff_text_hash": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "change_type", "hunks", "context_before", "context_after"],
        "properties": {
          "path": {"type": "string"},
          "language": {"type": "string"},
          "change_type": {"type": "string", "enum": ["modified", "renamed", "deleted"]},
          "context_before": {"type": "string", "description": "up to 5 lines of context before the first hunk"},
          "context_after": {"type": "string", "description": "up to 5 lines of context after the last hunk"},
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lines"],
              "properties": {
                "source_start": {"type": "integer"},
                "source_length": {"type": "integer"},
                "target_start": {"type": "integer"},
                "target_length": {"type": "integer"},
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "content"],
                    "properties": {
                      "type": {"type": "string", "enum": ["add", "del", "ctx"]},
                      "content": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
