{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CouncilAI agent verdict",
  "description": "Contract Person A's agents produce and Person B's orchestrator validates. Committed at the Hour 1 sync.",
  "type": "object",
  "required": ["decision", "confidence", "reasoning", "citations"],
  "properties": {
    "decision": {"type": "string", "enum": ["APPROVE", "REJECT", "WARN"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reasoning": {"type": "string"},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line_start", "line_end"],
        "properties": {
          "file": {"type": "string"},
          "line_start": {"type": "integer"},
          "line_end": {"type": "integer"},
          "snippet": {"type": "string"}
        }
      }
    }
  }
}
