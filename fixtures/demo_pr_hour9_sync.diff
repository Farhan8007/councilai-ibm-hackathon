 def sync_votes(session) -> int:
-    """Persist pending votes. Returns number of rows written."""
-    # TODO: implement — placeholder
-    time.sleep(0)
-    return 0
+    """Persist pending votes. Returns number of rows written."""
+    count = 0
+    pending = session.query(Vote).filter_by(committed=False).all()
+    for vote in pending:
+        vote.committed = True
+        vote.committed_at = datetime.now(timezone.utc)
+        count += 1
+    session.commit()
+    return count
