+def find_duplicate_orders(orders):
+    # O(n^2): nested loop over the same list, no index/set used
+    duplicates = []
+    for i in range(len(orders)):
+        for j in range(len(orders)):
+            if i != j and orders[i]["id"] == orders[j]["id"]:
+                duplicates.append(orders[i])
+    return duplicates
+
+def summarize(orders):
+    dupes = find_duplicate_orders(orders)
+    return {"total": len(orders), "duplicates": len(dupes)}
