@@ -0,0 +1,21 @@
+"""Unit tests for backend/sync.py added in hour-9 sync PR."""
+
+import pytest
+from unittest.mock import MagicMock
+
+
+def _make_vote(committed=False):
+    v = MagicMock()
+    v.committed = committed
+    v.committed_at = None
+    return v
+
+
+def test_sync_votes_commits_pending(monkeypatch):
+    session = MagicMock()
+    votes = [_make_vote(), _make_vote()]
+    session.query.return_value.filter_by.return_value.all.return_value = votes
+
+    from backend.sync import sync_votes
+    result = sync_votes(session)
+
+    assert result == 2
+    session.commit.assert_called_once()
